# BTC Reflex Engine — Environment Variables
# All keys prefixed REFLEX_ to avoid collision with BTC Brain Ops environment.

# ── Database ───────────────────────────────────────────────────────────────
REFLEX_DATABASE_URL=sqlite:///reflex.db

# ── Telegram ───────────────────────────────────────────────────────────────
REFLEX_TELEGRAM_BOT_TOKEN=
REFLEX_TELEGRAM_CHAT_ID=

# ── Brain Ops Read-Only Endpoint ───────────────────────────────────────────
REFLEX_BRAIN_STATE_URL=https://your-brain-ops-url.up.railway.app/brain-state

# ── Binance Feed ───────────────────────────────────────────────────────────
REFLEX_BINANCE_BASE_URL=https://api.binance.com
REFLEX_SYMBOL=BTCUSDT

# ── System Mode ────────────────────────────────────────────────────────────
REFLEX_MODE=observer

# ── Scheduler ──────────────────────────────────────────────────────────────
REFLEX_POLL_INTERVAL_4H=3600
REFLEX_POLL_INTERVAL_1H=900

# ── Structure Detection ────────────────────────────────────────────────────
REFLEX_SWING_LOOKBACK=5
REFLEX_BOUNDARY_PROXIMITY_PCT=0.03

# ── Alerts ─────────────────────────────────────────────────────────────────
REFLEX_ALERT_THRESHOLD=0.40
